# ----------------------------
# Kafka settings
# ----------------------------

# External Kafka port that clients use to connect from outside the container
KAFKA_EXTERNAL_PORT=${CORE_KAFKA_EXTERNAL_PORT}

# Internal Kafka port used inside the docker network
KAFKA_INTERNAL_PORT=${CORE_KAFKA_INTERNAL_PORT}

# Kafka controller port (used when running in KRaft mode)
KAFKA_CONTROLLER_PORT=${CORE_KAFKA_CONTROLLER_PORT}

# Port for the Kafka UI web interface (e.g. Kafdrop, Redpanda Console)
KAFKA_UI_PORT=${CORE_KAFKA_UI_PORT}
