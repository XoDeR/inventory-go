# ----------------------------
# HTTP server settings
# ----------------------------

# Address the HTTP server listens on
HTTP_HOST=${ORDER_HTTP_HOST}

# Port the HTTP server listens on
HTTP_PORT=${ORDER_HTTP_PORT}


# ----------------------------
# Upstream gRPC services
# ----------------------------

# Inventory service gRPC address
INVENTORY_GRPC_HOST=${INVENTORY_GRPC_HOST}
INVENTORY_GRPC_PORT=${INVENTORY_GRPC_PORT}

# Payment service gRPC address
PAYMENT_GRPC_HOST=${PAYMENT_GRPC_HOST}
PAYMENT_GRPC_PORT=${PAYMENT_GRPC_PORT}


# ----------------------------
# PostgreSQL settings
# ----------------------------

# PostgreSQL Docker image name (for docker-compose)
POSTGRES_IMAGE_NAME=${ORDER_POSTGRES_IMAGE_NAME}

# External PostgreSQL port (to connect from outside the container)
EXTERNAL_POSTGRES_PORT=${ORDER_EXTERNAL_POSTGRES_PORT}

# PostgreSQL host
POSTGRES_HOST=${ORDER_POSTGRES_HOST}

# PostgreSQL port
POSTGRES_PORT=${ORDER_POSTGRES_PORT}

# Database name
POSTGRES_DB=${ORDER_POSTGRES_DB}

# Database user name
POSTGRES_USER=${ORDER_POSTGRES_USER}

# Database user password
POSTGRES_PASSWORD=${ORDER_POSTGRES_PASSWORD}


# ----------------------------
# Logger settings
# ----------------------------

# Log level (debug, info, warn, error)
LOGGER_LEVEL=${ORDER_LOGGER_LEVEL}

# Write logs as JSON (true/false)
LOGGER_AS_JSON=${ORDER_LOGGER_AS_JSON}


# ----------------------------
# Kafka settings
# ----------------------------

# Comma-separated list of brokers
KAFKA_BROKERS=${CORE_KAFKA_BROKERS}

# Topic OrderPaid events are published to
ORDER_PAID_TOPIC_NAME=${CORE_ORDER_PAID_TOPIC_NAME}

# Topic ComputerAssembled events are read from
COMPUTER_ASSEMBLED_TOPIC_NAME=${CORE_COMPUTER_ASSEMBLED_TOPIC_NAME}

# Consumer group of the ComputerAssembled consumer
ORDER_ASSEMBLED_CONSUMER_GROUP_ID=${ORDER_ASSEMBLED_CONSUMER_GROUP_ID}


# ----------------------------
# Redis settings
# ----------------------------

# Redis Docker image name (for docker-compose)
REDIS_IMAGE_NAME=${ORDER_REDIS_IMAGE_NAME}

# External Redis port (to connect from outside the container)
EXTERNAL_REDIS_PORT=${ORDER_EXTERNAL_REDIS_PORT}

# Redis host
REDIS_HOST=${ORDER_REDIS_HOST}

# Redis port
REDIS_PORT=${ORDER_REDIS_PORT}

# Timeout of getting a connection from the pool
REDIS_CONNECTION_TIMEOUT=${ORDER_REDIS_CONNECTION_TIMEOUT}

# Maximum number of idle connections in the pool
REDIS_MAX_IDLE=${ORDER_REDIS_MAX_IDLE}

# Time after which an idle connection is considered stale
REDIS_IDLE_TIMEOUT=${ORDER_REDIS_IDLE_TIMEOUT}

# Time to live of a cache entry
REDIS_CACHE_TTL=${ORDER_REDIS_CACHE_TTL}
