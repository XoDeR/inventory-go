# ----------------------------
# Kafka settings
# ----------------------------

# Comma-separated list of brokers
KAFKA_BROKERS=${CORE_KAFKA_BROKERS}

# Topic OrderPaid events are read from
ORDER_PAID_TOPIC_NAME=${CORE_ORDER_PAID_TOPIC_NAME}

# Consumer group of the OrderPaid consumer
ORDER_PAID_CONSUMER_GROUP_ID=${ASSEMBLY_ORDER_PAID_CONSUMER_GROUP_ID}

# Topic ComputerAssembled events are published to
COMPUTER_ASSEMBLED_TOPIC_NAME=${CORE_COMPUTER_ASSEMBLED_TOPIC_NAME}


# ----------------------------
# Assembly settings
# ----------------------------

# How long the assembly of a computer takes (Go duration)
ASSEMBLY_DURATION=${ASSEMBLY_DURATION}


# ----------------------------
# Logger settings
# ----------------------------

# Log level (debug, info, warn, error)
LOGGER_LEVEL=${ASSEMBLY_LOGGER_LEVEL}

# Write logs as JSON (true/false)
LOGGER_AS_JSON=${ASSEMBLY_LOGGER_AS_JSON}
