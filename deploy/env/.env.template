# -----------------------------------------
# SHARED CONFIGURATION FILE OF THE MICROSERVICE ARCHITECTURE
# -----------------------------------------
# This file holds the environment variables of all services,
# prefixed with the service name to avoid name conflicts.
# Copy it to deploy/env/.env (task env:generate does it automatically)
# and run `task env:generate` to produce the per-service
# deploy/compose/<service>/.env files.
# -----------------------------------------

# -----------------------------------------
# CORE SETTINGS (SHARED COMPONENTS)
# -----------------------------------------

# Kafka settings
CORE_KAFKA_EXTERNAL_PORT=9092
CORE_KAFKA_INTERNAL_PORT=29092
CORE_KAFKA_CONTROLLER_PORT=29093
CORE_KAFKA_UI_PORT=8090

# Broker address for services running on the host (the external listener)
CORE_KAFKA_BROKERS=localhost:${CORE_KAFKA_EXTERNAL_PORT}

# Topics shared between the services (see contracts/)
CORE_ORDER_PAID_TOPIC_NAME=order.paid
CORE_COMPUTER_ASSEMBLED_TOPIC_NAME=assembly.computer-assembled

# -----------------------------------------
# INVENTORY SERVICE
# -----------------------------------------

# gRPC settings
INVENTORY_GRPC_HOST=localhost
INVENTORY_GRPC_PORT=50051

# HTTP gateway settings (REST -> gRPC + Swagger UI)
INVENTORY_HTTP_HOST=localhost
INVENTORY_HTTP_PORT=8081

# Logger
INVENTORY_LOGGER_LEVEL=info
INVENTORY_LOGGER_AS_JSON=true

# MongoDB
INVENTORY_MONGO_IMAGE_NAME=mongo:7.0.5
INVENTORY_EXTERNAL_MONGO_PORT=27017
INVENTORY_MONGO_HOST=localhost
INVENTORY_MONGO_PORT=27017
INVENTORY_MONGO_INITDB_DATABASE=inventory-service
INVENTORY_MONGO_AUTH_DB=admin
INVENTORY_MONGO_INITDB_ROOT_USERNAME=inventory-service-user
INVENTORY_MONGO_INITDB_ROOT_PASSWORD=inventory-service-password

# -----------------------------------------
# ORDER SERVICE
# -----------------------------------------

# HTTP settings
ORDER_HTTP_HOST=localhost
ORDER_HTTP_PORT=8080

# Logger
ORDER_LOGGER_LEVEL=info
ORDER_LOGGER_AS_JSON=true

# PostgreSQL
ORDER_POSTGRES_IMAGE_NAME=postgres:17.0-alpine3.20
ORDER_EXTERNAL_POSTGRES_PORT=5432
ORDER_POSTGRES_HOST=localhost
ORDER_POSTGRES_PORT=5432
ORDER_POSTGRES_DB=order-service
ORDER_POSTGRES_USER=order-service-user
ORDER_POSTGRES_PASSWORD=order-service-password

# Kafka consumer group of the ComputerAssembled consumer
ORDER_ASSEMBLED_CONSUMER_GROUP_ID=order-service

# -----------------------------------------
# PAYMENT SERVICE
# -----------------------------------------

# gRPC settings
PAYMENT_GRPC_HOST=localhost
PAYMENT_GRPC_PORT=50052

# Logger
PAYMENT_LOGGER_LEVEL=info
PAYMENT_LOGGER_AS_JSON=true

# HTTP gateway settings (REST -> gRPC + Swagger UI)
PAYMENT_HTTP_HOST=localhost
PAYMENT_HTTP_PORT=8082

# -----------------------------------------
# ASSEMBLY SERVICE
# -----------------------------------------

# Logger
ASSEMBLY_LOGGER_LEVEL=info
ASSEMBLY_LOGGER_AS_JSON=true

# Kafka consumer group of the OrderPaid consumer
ASSEMBLY_ORDER_PAID_CONSUMER_GROUP_ID=assembly-service

# How long the assembly of a computer takes
ASSEMBLY_DURATION=10s

# -----------------------------------------
# NOTIFICATION SERVICE
# -----------------------------------------

# Logger
NOTIFICATION_LOGGER_LEVEL=info
NOTIFICATION_LOGGER_AS_JSON=true

# Kafka consumer groups
NOTIFICATION_ORDER_PAID_CONSUMER_GROUP_ID=notification-service-order-paid
NOTIFICATION_COMPUTER_ASSEMBLED_CONSUMER_GROUP_ID=notification-service-computer-assembled
