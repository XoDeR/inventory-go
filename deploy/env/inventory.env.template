# ----------------------------
# gRPC server settings
# ----------------------------

# Address the gRPC server listens on
GRPC_HOST=${INVENTORY_GRPC_HOST}

# Port the gRPC server listens on
GRPC_PORT=${INVENTORY_GRPC_PORT}


# ----------------------------
# HTTP gateway settings
# ----------------------------

# Address the HTTP gateway listens on
HTTP_HOST=${INVENTORY_HTTP_HOST}

# Port the HTTP gateway listens on
HTTP_PORT=${INVENTORY_HTTP_PORT}


# ----------------------------
# MongoDB settings
# ----------------------------

# MongoDB Docker image name (for docker-compose)
MONGO_IMAGE_NAME=${INVENTORY_MONGO_IMAGE_NAME}

# External MongoDB port (to connect from outside the container)
EXTERNAL_MONGO_PORT=${INVENTORY_EXTERNAL_MONGO_PORT}

# MongoDB host
MONGO_HOST=${INVENTORY_MONGO_HOST}

# MongoDB port
MONGO_PORT=${INVENTORY_MONGO_PORT}

# Default database name
MONGO_INITDB_DATABASE=${INVENTORY_MONGO_INITDB_DATABASE}

# Authentication database
MONGO_AUTH_DB=${INVENTORY_MONGO_AUTH_DB}

# MongoDB root user name
MONGO_INITDB_ROOT_USERNAME=${INVENTORY_MONGO_INITDB_ROOT_USERNAME}

# MongoDB root user password
MONGO_INITDB_ROOT_PASSWORD=${INVENTORY_MONGO_INITDB_ROOT_PASSWORD}


# ----------------------------
# Logger settings
# ----------------------------

# Log level (debug, info, warn, error)
LOGGER_LEVEL=${INVENTORY_LOGGER_LEVEL}

# Write logs as JSON (true/false)
LOGGER_AS_JSON=${INVENTORY_LOGGER_AS_JSON}


# ----------------------------
# Redis settings
# ----------------------------

# Redis Docker image name (for docker-compose)
REDIS_IMAGE_NAME=${INVENTORY_REDIS_IMAGE_NAME}

# External Redis port (to connect from outside the container)
EXTERNAL_REDIS_PORT=${INVENTORY_EXTERNAL_REDIS_PORT}

# Redis host
REDIS_HOST=${INVENTORY_REDIS_HOST}

# Redis port
REDIS_PORT=${INVENTORY_REDIS_PORT}

# Timeout of getting a connection from the pool
REDIS_CONNECTION_TIMEOUT=${INVENTORY_REDIS_CONNECTION_TIMEOUT}

# Maximum number of idle connections in the pool
REDIS_MAX_IDLE=${INVENTORY_REDIS_MAX_IDLE}

# Time after which an idle connection is considered stale
REDIS_IDLE_TIMEOUT=${INVENTORY_REDIS_IDLE_TIMEOUT}

# Time to live of a cache entry
REDIS_CACHE_TTL=${INVENTORY_REDIS_CACHE_TTL}
