# ----------------------------
# gRPC server settings
# ----------------------------

# Address the gRPC server listens on
GRPC_HOST=${AUTH_GRPC_HOST}

# Port the gRPC server listens on
GRPC_PORT=${AUTH_GRPC_PORT}


# ----------------------------
# Logger settings
# ----------------------------

# Log level (debug, info, warn, error)
LOGGER_LEVEL=${AUTH_LOGGER_LEVEL}

# Write logs as JSON (true/false)
LOGGER_AS_JSON=${AUTH_LOGGER_AS_JSON}


# ----------------------------
# PostgreSQL settings (users)
# ----------------------------

# PostgreSQL Docker image name (for docker-compose)
POSTGRES_IMAGE_NAME=${AUTH_POSTGRES_IMAGE_NAME}

# External PostgreSQL port (to connect from outside the container)
EXTERNAL_POSTGRES_PORT=${AUTH_EXTERNAL_POSTGRES_PORT}

# PostgreSQL host
POSTGRES_HOST=${AUTH_POSTGRES_HOST}

# PostgreSQL port
POSTGRES_PORT=${AUTH_POSTGRES_PORT}

# Database name
POSTGRES_DB=${AUTH_POSTGRES_DB}

# User name
POSTGRES_USER=${AUTH_POSTGRES_USER}

# User password
POSTGRES_PASSWORD=${AUTH_POSTGRES_PASSWORD}


# ----------------------------
# Redis settings (sessions)
# ----------------------------

# Redis Docker image name (for docker-compose)
REDIS_IMAGE_NAME=${AUTH_REDIS_IMAGE_NAME}

# External Redis port (to connect from outside the container)
EXTERNAL_REDIS_PORT=${AUTH_EXTERNAL_REDIS_PORT}

# Redis host
REDIS_HOST=${AUTH_REDIS_HOST}

# Redis port
REDIS_PORT=${AUTH_REDIS_PORT}

# Timeout of getting a connection from the pool
REDIS_CONNECTION_TIMEOUT=${AUTH_REDIS_CONNECTION_TIMEOUT}

# Maximum number of idle connections in the pool
REDIS_MAX_IDLE=${AUTH_REDIS_MAX_IDLE}

# Time after which an idle connection is considered stale
REDIS_IDLE_TIMEOUT=${AUTH_REDIS_IDLE_TIMEOUT}


# ----------------------------
# Session settings
# ----------------------------

# Lifetime (TTL) of a user session in Redis
SESSION_TTL=${AUTH_SESSION_TTL}
