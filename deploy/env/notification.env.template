# ----------------------------
# Kafka settings
# ----------------------------

# Comma-separated list of brokers
KAFKA_BROKERS=${CORE_KAFKA_BROKERS}

# Topic OrderPaid events are read from
ORDER_PAID_TOPIC_NAME=${CORE_ORDER_PAID_TOPIC_NAME}

# Consumer group of the OrderPaid consumer
ORDER_PAID_CONSUMER_GROUP_ID=${NOTIFICATION_ORDER_PAID_CONSUMER_GROUP_ID}

# Topic ComputerAssembled events are read from
COMPUTER_ASSEMBLED_TOPIC_NAME=${CORE_COMPUTER_ASSEMBLED_TOPIC_NAME}

# Consumer group of the ComputerAssembled consumer
COMPUTER_ASSEMBLED_CONSUMER_GROUP_ID=${NOTIFICATION_COMPUTER_ASSEMBLED_CONSUMER_GROUP_ID}


# ----------------------------
# Slack bot settings
# ----------------------------

# Bot User OAuth Token (xoxb-...), used to post messages
SLACK_BOT_TOKEN=${NOTIFICATION_SLACK_BOT_TOKEN}

# App-level token (xapp-...) with connections:write, used by Socket Mode
SLACK_APP_TOKEN=${NOTIFICATION_SLACK_APP_TOKEN}

# ID (C...) of the channel notifications are posted to
SLACK_CHANNEL_ID=${NOTIFICATION_SLACK_CHANNEL_ID}


# ----------------------------
# Logger settings
# ----------------------------

# Log level (debug, info, warn, error)
LOGGER_LEVEL=${NOTIFICATION_LOGGER_LEVEL}

# Write logs as JSON (true/false)
LOGGER_AS_JSON=${NOTIFICATION_LOGGER_AS_JSON}
